--information:${SCRIPT_NAME} ${VERSION} by ${AUTHOR}
--label:${LABEL}
--track0:X Center,-4000,4000,0,0.01
--track1:Y Center,-4000,4000,0,0.01
--track2:Tile Size,0,1000,100,0.01
--track3:Rotation,-3600,3600,0,0.01
--track4:Scale,0,1000,100,0.01
--check0:Floating Center,0
--select@s0:Mirroring,Unfold=0,Wheel=1,Fish Head=2,Can Meas=3,Flip Flop=4,Flower=5,Dia Cross=6,Flipper=7,Starlish=8,Tiler=9
--value@_0:PI,{}
--[[pixelshader@kaleidoscope:
--#include "shaders/kaleidoscope.hlsl"
]]

if (obj.getinfo("version") < 2001800) then
    debug_print("AviUtl ExEdit2 beta18 or later is required.")
    return
end

obj.setanchor("track", 0, "line")

local eps = 1.0e-4
local w, h = obj.getpixel()

local function tobool(v, d)
    if (type(v) == "boolean") then
        return v
    elseif (type(v) == "number") then
        return v ~= 0
    else
        return d
    end
end

_0 = _0 or {}
local cx = (tonumber(_0.cx) or obj.track0) / w + 0.5
local cy = (tonumber(_0.cy) or obj.track1) / h + 0.5
local size = math.max((tonumber(_0.tile_size) or obj.track2) * 0.01, eps)
local rot = math.rad(tonumber(_0.rotation) or obj.track3)
local scale = math.max((tonumber(_0.scale) or obj.track4) * 0.01, eps)
local floating_c = tobool(_0.floating_center, obj.check0)
local mirroring = tonumber(_0.mirroring) or s0 s0 = nil
_0 = nil

local aspect = h / w
local ox, oy = 0.5, 0.5
if (floating_c) then
    ox, oy = cx, cy
end

local c = math.cos(rot)
local s = math.sin(rot)
obj.pixelshader("kaleidoscope", "object", "object", {
    c,  s, 0.0, 0.0, -- Padding
    -s, c,
    ox, oy,
    cx, cy,
    aspect,
    size,
    scale,
    mirroring
}, "copy", "mirror")
